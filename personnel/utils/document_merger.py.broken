import os
import io
import zipfile
from datetime import datetime
from django.core.files.base import ContentFile
from django.conf import settings
from PyPDF2 import PdfMerger, PdfReader
from reportlab.pdfgen import canvas
from reportlab.lib.pagesizes import A4
from reportlab.lib import colors
import tempfile
from PIL import Image as PILImage
import logging

logger = logging.getLogger(__name__)


class DocumentMerger:
    # ... existing code ...

    def merge_and_download(self, format='pdf'):
        """
        Merge documents and return as downloadable content
        
        Args:
            format: 'pdf' or 'zip'
        
        Returns:
            tuple: (success, content, filename, error_message)
        """
        if format == 'pdf':
            success, path, error = self.merge_to_pdf()
            if success and path:
                with open(path, 'rb') as f:
                    content = f.read()
                filename = os.path.basename(path)
                return True, content, filename, None
            return False, None, None, error
        else:
            # For ZIP, we first need to create the merged PDF
            # Then package it into a ZIP
            success, pdf_path, error = self.merge_to_pdf()
            
            if not success:
                return False, None, None, f"PDF merge failed: {error}"
            
            try:
                # Create ZIP containing the merged PDF
                zip_buffer = io.BytesIO()
                
                with zipfile.ZipFile(zip_buffer, 'w', zipfile.ZIP_DEFLATED) as zip_file:
                    # Add the merged PDF
                    merged_pdf_filename = os.path.basename(pdf_path)
                    zip_file.write(pdf_path, merged_pdf_filename)
                    
                    # Add a README file with details
                    readme_content = f"""DCMP MANAGEMENT - DOCUMENT PACKAGE
=====================================

Personnel: {self.personnel.full_name()}
Type: {self.personnel.get_personnel_type_display()}
Nationality: {self.personnel.nationality}
Email: {self.personnel.email}
Phone: {self.personnel.phone}
Meeting: {self.personnel.meeting.name if self.personnel.meeting else 'Not assigned'}

Documents Included:
"""
                    doc_order = self.get_document_order()
                    for i, doc_type in enumerate(doc_order, 1):
                        if doc_type in self.documents:
                            doc_name = self.DOC_DISPLAY_NAMES.get(doc_type, doc_type.title().replace('_', ' '))
                            readme_content += f"{i}. {doc_name}\n"
                    
                    readme_content += f"\nGenerated: {datetime.now().strftime('%B %d, %Y at %H:%M')}\n"
                    readme_content += "\nGenerated by DCMP Management System\n"
                    
                    zip_file.writestr('README.txt', readme_content)
                
                # Get ZIP content
                zip_buffer.seek(0)
                content = zip_buffer.getvalue()
                
                # Generate ZIP filename
                zip_filename = f"{self.personnel.full_name()}_documents.zip"
                
                # Clean up the intermediate PDF
                if os.path.exists(pdf_path):
                    try:
                        os.remove(pdf_path)
                    except:
                        pass
                
                return True, content, zip_filename, None
                
            except Exception as e:
                logger.error(f"Error creating ZIP package: {e}")
                return False, None, None, str(e)

    def get_merged_pdf_path(self):
        """
        Get the path to the merged PDF if it already exists
        Returns None if not found
        """
        # Check common locations for merged PDFs
        possible_paths = [
            os.path.join(settings.MEDIA_ROOT, 'merged_documents', f"{self.personnel.full_name()}_merged_documents.pdf"),
            os.path.join(settings.MEDIA_ROOT, 'merged_documents', f"{self.personnel.full_name()}_merged.pdf"),
        ]
        
        for path in possible_paths:
            if os.path.exists(path):
                return path
        
        return None

    def has_merged_pdf(self):
        """Check if a merged PDF already exists"""
        return self.get_merged_pdf_path() is not None

    def zip_merged_pdf(self, output_filename=None):
        """
        Create a ZIP containing the already-merged PDF
        Only works if a merged PDF exists
        
        Returns:
            tuple: (success, content, filename, error_message)
        """
        if not self.has_all_documents():
            missing = self.get_missing_documents_display()
            return False, None, None, f"Missing documents: {', '.join(missing)}"
        
        # Check if merged PDF exists
        pdf_path = self.get_merged_pdf_path()
        if not pdf_path:
            return False, None, None, "Merged PDF not found. Please merge documents first."
        
        if output_filename is None:
            output_filename = f"{self.personnel.full_name()}_documents.zip"
        
        if not output_filename.endswith('.zip'):
            output_filename += '.zip'
        
        try:
            zip_buffer = io.BytesIO()
            
            with zipfile.ZipFile(zip_buffer, 'w', zipfile.ZIP_DEFLATED) as zip_file:
                # Add the merged PDF
                merged_pdf_filename = os.path.basename(pdf_path)
                zip_file.write(pdf_path, merged_pdf_filename)
                
                # Add README
                readme_content = f"""DCMP MANAGEMENT - DOCUMENT PACKAGE
=====================================

Personnel: {self.personnel.full_name()}
Type: {self.personnel.get_personnel_type_display()}
Nationality: {self.personnel.nationality}
Email: {self.personnel.email}
Phone: {self.personnel.phone}
Meeting: {self.personnel.meeting.name if self.personnel.meeting else 'Not assigned'}

Documents Included:
"""
                doc_order = self.get_document_order()
                for i, doc_type in enumerate(doc_order, 1):
                    if doc_type in self.documents:
                        doc_name = self.DOC_DISPLAY_NAMES.get(doc_type, doc_type.title().replace('_', ' '))
                        readme_content += f"{i}. {doc_name}\n"
                
                readme_content += f"\nGenerated: {datetime.now().strftime('%B %d, %Y at %H:%M')}\n"
                readme_content += "\nGenerated by DCMP Management System\n"
                
                zip_file.writestr('README.txt', readme_content)
            
            zip_buffer.seek(0)
            content = zip_buffer.getvalue()
            
            return True, content, output_filename, None
            
        except Exception as e:
            logger.error(f"Error creating ZIP from merged PDF: {e}")
            return False, None, None, str(e)

